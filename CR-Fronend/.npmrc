# ng-apexcharts 1.11.0 declara que necesita Angular 18 y el proyecto va por el
# 19. En la práctica funciona —los gráficos del Panel de Control salen bien—,
# pero npm se planta y no instala nada si no se le dice que lo pase por alto.
#
# Esto ya estaba pasando: quien instaló las dependencias en su máquina lo
# resolvió a mano con --legacy-peer-deps. Sin dejarlo escrito acá, cualquier
# `npm ci` limpio —el de otro compañero, o el de la imagen de Docker— falla con
# ERESOLVE y no hay forma de compilar.
#
# Cuando ng-apexcharts publique una versión para Angular 19, se sube y se borra
# esta línea.
legacy-peer-deps=true
