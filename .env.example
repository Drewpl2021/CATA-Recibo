# ─────────────────────────────────────────────────────────────
#  Configuración del despliegue con Docker
# ─────────────────────────────────────────────────────────────
#  Copia este archivo como .env en la RAÍZ del proyecto (junto a
#  compose.yaml) y rellena lo que falta:
#
#      cp .env.example .env
#
#  Ojo: este .env es el del despliegue, distinto del que usa
#  CR-Backend cuando trabajas en tu máquina.
#
#  NO subas el .env a git: lleva las contraseñas del servidor.
# ─────────────────────────────────────────────────────────────

APP_NAME=CATA-Recibo

# La dirección por la que la gente va a entrar. Hoy, la IP del
# VPS; cuando tengan dominio, se cambia acá y se reinicia — el
# frontend no hay que recompilarlo, porque pide "/api" relativo.
APP_URL=http://192.0.2.10

# Se genera UNA vez y no se cambia más:
#     docker compose run --rm app php artisan key:generate --show
# Si se cambia después, las contraseñas siguen valiendo (van con
# hash) pero las sesiones abiertas se caen.
APP_KEY=

# ── Base de datos ────────────────────────────────────────────
# Van en el compose y las lee MySQL al crearse. Cámbialas ANTES
# de levantar la primera vez: después ya no se aplican solas.
DB_DATABASE=colegio_db
DB_USERNAME=cata
DB_PASSWORD=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-esta-tambien

# ── Puerto por el que sale al mundo ──────────────────────────
PUERTO_HTTP=80

# ── Correo ───────────────────────────────────────────────────
# Con 'log' los correos NO se envían: quedan escritos en el log
# del contenedor. Sirve para probar sin molestar a nadie.
# Para que salgan de verdad (avisos de boleta y el enlace de
# "olvidé mi contraseña") pon 'smtp' y los datos del buzón del
# colegio.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@cata.edu.pe

# ── Otros ────────────────────────────────────────────────────
# Minutos de inactividad antes de cerrar la sesión. Mientras se
# esté trabajando la sesión se renueva sola.
SESION_INACTIVIDAD_MINUTOS=120

# debug / info / warning / error
LOG_LEVEL=warning

# ── Búsqueda de personas por DNI (opcional) ──────────────────
# Al dar de alta a un trabajador, RR.HH. escribe el DNI y el sistema trae
# nombres y apellidos. Sin nada de esto relleno, el sistema sigue
# funcionando igual: RR.HH. escribe los datos a mano, como siempre.
#
# 1) La base propia del colegio (RENSUN), si la tienen accesible desde el
#    servidor. Gratis y va primero. Sin RENSUN_DB_HOST no se ni intenta.
RENSUN_DB_HOST=
RENSUN_DB_PORT=3306
RENSUN_DB_DATABASE=
RENSUN_DB_USERNAME=
RENSUN_DB_PASSWORD=
# Cómo se llaman la tabla y las columnas en esa base. Tras levantar el
# sistema, `docker compose exec app php artisan dni:diagnostico` las lista.
RENSUN_TABLA=padron
RENSUN_COL_DNI=dni
RENSUN_COL_NOMBRES=nombres
RENSUN_COL_APE_PATERNO=apellido_paterno
RENSUN_COL_APE_MATERNO=apellido_materno
RENSUN_COL_NACIMIENTO=fecha_nacimiento
RENSUN_COL_DIRECCION=direccion

# 2) Decolecta, de pago por consulta. Solo se llama cuando la base propia
#    no tiene a esa persona (o no está configurada).
DECOLECTA_TOKEN=
