APP_NAME="CATA Recibo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# URL del Angular (CR-Fronend) permitido por CorsMiddleware
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Laragon trae MySQL 8.4 en 127.0.0.1:3306, usuario root sin password.
# La base "colegio_db" se crea con: php artisan migrate:fresh --seed
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=colegio_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Por defecto los correos solo se escriben en el log (storage/logs/laravel.log).
# Para probarlos de verdad con Laragon: levanta Mailpit y usa este bloque
# (bandeja web en http://localhost:8025):
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@cata.edu.pe"
MAIL_FROM_NAME="${APP_NAME}"

# Minutos que una sesion aguanta SIN actividad antes de cerrarse. Cada
# peticion la reinicia, asi que trabajando no se cae nunca. Por defecto 120.
SESION_INACTIVIDAD_MINUTOS=120
