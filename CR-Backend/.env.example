APP_NAME="CATA Recibo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# URL del frontend Angular permitido por CorsMiddleware
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Rellena estos valores con los de TU servidor de base de datos.
# Nunca subas credenciales reales a este archivo: es de ejemplo y va al
# repositorio. Las de verdad viven solo en el .env, que está ignorado por git.
# La base se crea con: php artisan migrate:fresh --seed
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Correo ──────────────────────────────────────────────────────────
# Sin esto NADIE recibe el aviso de su boleta ni el enlace de "olvidé mi
# contraseña". Con MAIL_MAILER=log los correos se escriben en
# storage/logs/laravel.log y no salen del equipo: sirve para desarrollar,
# no para producción.
#
# Para probarlos en local con una bandeja de pruebas (Mailpit o similar):
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
#
# Con un proveedor que exige verificación en dos pasos, genera una
# "contraseña de aplicación" desde el panel de esa cuenta y pon ESA en
# MAIL_PASSWORD, no la contraseña normal. Usa una cuenta dedicada solo a
# enviar, nunca una personal.
#
# Probar que sale de verdad:   php artisan correo:probar destino@ejemplo.com
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
# "smtp" en el 587 (STARTTLS) o "smtps" en el 465. "tls" no vale.
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@ejemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

# Minutos que una sesion aguanta SIN actividad antes de cerrarse. Cada
# peticion la reinicia, asi que trabajando no se cae nunca. Por defecto 120.
SESION_INACTIVIDAD_MINUTOS=120

# Dominio de correo de la institución, sin la arroba. Solo sirve para marcar
# qué cuentas ya tienen el correo definitivo y cuáles siguen con uno
# provisional. Si se deja vacío, ninguna se marca y todo lo demás funciona.
INSTITUCION_DOMINIO_CORREO=

# ── Búsqueda de personas por DNI (alta de trabajadores) ──────────────
# Proveedor externo de consulta. Se paga por consulta, así que la base
# local (si está configurada) se consulta primero.
DECOLECTA_BASE_URL=https://api.decolecta.com
DECOLECTA_TOKEN=
DECOLECTA_RUTA_DNI=/v1/reniec/dni

# Base de datos local del padrón, opcional. Déjala vacía si no la tienes:
# el sistema usa entonces el proveedor externo.
RENSUN_DB_HOST=
RENSUN_DB_PORT=3306
RENSUN_DB_DATABASE=
RENSUN_DB_USERNAME=
RENSUN_DB_PASSWORD=

# Cómo se llaman la tabla y las columnas dentro de esa base.
# `php artisan dni:diagnostico` las lista para poder rellenar esto.
RENSUN_TABLA=padron
RENSUN_COL_DNI=dni
RENSUN_COL_NOMBRES=nombres
RENSUN_COL_APE_PATERNO=apellido_paterno
RENSUN_COL_APE_MATERNO=apellido_materno
RENSUN_COL_NACIMIENTO=fecha_nacimiento
RENSUN_COL_DIRECCION=direccion
