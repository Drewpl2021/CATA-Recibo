APP_NAME="CATA Recibo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# URL del Angular (CR-Fronend) permitido por CorsMiddleware
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Laragon trae MySQL 8.4 en 127.0.0.1:3306, usuario root sin password.
# La base "colegio_db" se crea con: php artisan migrate:fresh --seed
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=colegio_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Por defecto los correos solo se escriben en el log (storage/logs/laravel.log).
# Para probarlos de verdad con Laragon: levanta Mailpit y usa este bloque
# (bandeja web en http://localhost:8025):
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# ── Correo ──────────────────────────────────────────────────────────
# Sin esto NADIE recibe el aviso de su boleta ni el enlace de "olvidé mi
# contraseña". Con MAIL_MAILER=log los correos se escriben en
# storage/logs/laravel.log y no salen del servidor: sirve para desarrollar,
# no para el colegio.
#
# Google Workspace (@cata.edu.pe):
#   1. Usa una cuenta que sea solo para esto (p. ej. no-reply@cata.edu.pe).
#   2. En esa cuenta: Cuenta de Google -> Seguridad -> Verificación en dos
#      pasos (activarla) -> Contraseñas de aplicaciones -> crear una.
#   3. Esa contraseña de 16 letras va en MAIL_PASSWORD, no la de la cuenta.
#
# Probar que sale de verdad:   php artisan correo:probar tu-correo@cata.edu.pe
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# "smtp" en el 587 (STARTTLS) o "smtps" en el 465. "tls" no vale.
MAIL_SCHEME=smtp
MAIL_USERNAME=no-reply@cata.edu.pe
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@cata.edu.pe"
MAIL_FROM_NAME="${APP_NAME}"

# Minutos que una sesion aguanta SIN actividad antes de cerrarse. Cada
# peticion la reinicia, asi que trabajando no se cae nunca. Por defecto 120.
SESION_INACTIVIDAD_MINUTOS=120

# ── Búsqueda de personas por DNI (alta de trabajadores) ──────────────
# Decolecta se paga por consulta; la base del colegio es gratis y va primero.
DECOLECTA_BASE_URL=https://api.decolecta.com
DECOLECTA_TOKEN=
DECOLECTA_RUTA_DNI=/v1/reniec/dni

# La base del padrón. Vive en el servidor del colegio: desde una máquina de
# desarrollo normalmente no se llega, y el sistema tira de Decolecta.
RENSUN_DB_HOST=
RENSUN_DB_PORT=3306
RENSUN_DB_DATABASE=
RENSUN_DB_USERNAME=
RENSUN_DB_PASSWORD=

# Cómo se llaman la tabla y las columnas dentro de esa base.
# `php artisan dni:diagnostico` las lista para poder rellenar esto.
RENSUN_TABLA=padron
RENSUN_COL_DNI=dni
RENSUN_COL_NOMBRES=nombres
RENSUN_COL_APE_PATERNO=apellido_paterno
RENSUN_COL_APE_MATERNO=apellido_materno
RENSUN_COL_NACIMIENTO=fecha_nacimiento
RENSUN_COL_DIRECCION=direccion
