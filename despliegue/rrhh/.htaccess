# /public_html/rrhh — https://cata.edu.pe/rrhh/
#   /rrhh/api/…  →  index.php (el puente al backend Laravel en /apps/rrhh_backend)
#   lo demás     →  la aplicación Angular (index.html)

Options -MultiViews -Indexes

# La portada de la carpeta es el Angular, no el puente.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /rrhh/

    # El token de la sesión (Authorization: Bearer …) tiene que llegar a Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # La API (del sistema y del portal) va al backend.
    RewriteRule ^api(/.*)?$ index.php [L]

    # Archivos y carpetas que existen (js, css, imágenes): tal cual.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cualquier otra dirección (/rrhh/inicio/…): la resuelve Angular.
    RewriteRule ^ index.html [L]
</IfModule>

# index.html siempre fresco; los .js y .css llevan su huella en el nombre y pueden guardarse un año.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(js|mjs|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
