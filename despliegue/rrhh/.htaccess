# /public_html/rrhh — https://cata.edu.pe/rrhh/
#   /rrhh/api/…  →  index.php (el puente al backend Laravel en /apps/rrhh_backend)
#   lo demás     →  la aplicación Angular (index.html)

# PHP 8.3 para esta carpeta (el puente carga Laravel, que pide 8.3 o más).
# Sin esta línea el hosting usa PHP 8.1 y todo /rrhh/api responde 500. La
# pone cPanel (MultiPHP) en el .htaccess del servidor, y se perdía al
# reemplazarlo por el del zip: por eso viaja aquí.
AddHandler application/x-httpd-alt-php83___lsphp .php

Options -MultiViews -Indexes

# La portada de la carpeta es el Angular, no el puente.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /rrhh/

    # Siempre por https: por http viajarían la contraseña y el token sin cifrar.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # El token de la sesión (Authorization: Bearer …) tiene que llegar a Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # La API (del sistema y del portal) va al backend.
    RewriteRule ^api(/.*)?$ index.php [L]

    # Archivos y carpetas que existen (js, css, imágenes): tal cual.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cualquier otra dirección (/rrhh/inicio/…): la resuelve Angular.
    RewriteRule ^ index.html [L]
</IfModule>

# index.html siempre fresco; los .js y .css llevan su huella en el nombre y pueden guardarse un año.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(js|mjs|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # La pantalla solo carga lo suyo: si alguien lograra colar un script, no
    # podría correrlo ni mandar el token a otro sitio.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cata.edu.pe https://www.cata.edu.pe; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
